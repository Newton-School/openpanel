# STORAGE
REDIS_URL="redis://127.0.0.1:6379"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
DATABASE_URL_DIRECT="$DATABASE_URL"
CLICKHOUSE_URL="http://localhost:8123/openpanel"

# Symmetric key used to encrypt TOTP secrets and other sensitive data at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# REST
BATCH_SIZE="5000"
BATCH_INTERVAL="10000"
CONCURRENCY="10"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3333"
WORKER_PORT=9999
API_PORT=3333
# --- Newton fork: operational limits (all optional, defaults shown) ---
# Max users in a "View Users" CSV export (funnel step or chart data point).
# Read by the API. Profile rows are fetched by id in 500-id batches, so the
# cost of one export grows linearly with this value. Mixpanel caps at 10,000.
# VIEW_USERS_EXPORT_LIMIT=10000
# Max members materialised per cohort compute. Read by the worker (compute)
# and the API (cohort preview/count); keep both in sync. Cohorts above the
# cap are silently truncated to an arbitrary subset.
# COHORT_MATERIALIZE_LIMIT=10000
# Max cohorts per project. Read by the API on cohort create. Every non-static
# cohort is recomputed every 30 minutes, so this bounds that recurring load.
# MAX_COHORTS_PER_PROJECT=250
# Bytes before property-cohort GROUP BY spills to disk (worker + API).
# COHORT_QUERY_SPILL_BYTES=314572800
